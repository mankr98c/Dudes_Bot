# Discord Bot Credentials (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_server_guild_id_here

# Voice System Configuration
# Copy the Channel ID of your "➕ Join To Create" voice channel (Developer Mode -> Right Click Channel -> Copy Channel ID)
JOIN_TO_CREATE_CHANNEL_ID=your_join_to_create_channel_id_here

# Role IDs for Button Selection (Optional: Leave empty to auto-match by role name in the server)
ROLE_VALORANT_ID=
ROLE_APEX_ID=
ROLE_GENSHIN_ID=
ROLE_BGMI_ID=
ROLE_ANIME_ID=
ROLE_MOVIES_ID=
ROLE_NOTIFICATIONS_ID=
